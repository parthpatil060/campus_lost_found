rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function currentUserPath() {
      return /databases/$(database)/documents/users/$(uid());
    }
    function hasUserProfile() {
      return isSignedIn() && exists(currentUserPath());
    }
    function userRole() {
      return hasUserProfile() ? get(currentUserPath()).data.role : '';
    }
    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }
    function isVerifier() {
      return isSignedIn() &&
        (userRole() == 'verifier' || userRole() == 'admin');
    }

    // ── users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn() && (uid() == userId || isVerifier());
      allow create: if isSignedIn() && uid() == userId;
      allow update: if isSignedIn() && (uid() == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── lost_items ────────────────────────────────────────────────────────────
    match /lost_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // only owner or verifier/admin can update status
      allow update: if isSignedIn() && (
        resource.data.userId == uid() || isVerifier()
      );
      allow delete: if isAdmin();
    }

    // ── found_items ───────────────────────────────────────────────────────────
    match /found_items/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.finderId == uid() || isVerifier()
      );
      allow delete: if isAdmin();
    }

    // ── matches ───────────────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow create, update: if isVerifier();
      allow delete: if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      // user can only read their own; verifiers can create for others
      allow read: if isSignedIn() &&
        (resource.data.userId == uid() || isVerifier());
      allow create: if isSignedIn() &&
        (request.resource.data.userId == uid() || isVerifier());
      allow update: if isSignedIn() &&
        (resource.data.userId == uid() || isVerifier());
      allow delete: if isAdmin();
    }

    // ── broadcasts ────────────────────────────────────────────────────────────
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow create: if isVerifier();
      // users can update readBy (arrayUnion); verifiers can deactivate
      allow update: if isSignedIn() && (
        isVerifier() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
      );
      allow delete: if isAdmin();
    }
  }
}
